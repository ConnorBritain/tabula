# Eval data holds student speech from real rounds. Never commit or publish it.
evals/.data/

# The business plan stays private (prices, margins, strategy).
BUSINESS-PLAN.md

# Library reviewer names stay private until they agree to be named.
docs/library/REVIEWERS.local.md

# Picture tools: this computer's private settings (archive path). See docs/library/visuals/STYLE.md §6.
docs/library/visuals/local.json

# Owner legal and business drafts (operating agreements, entity papers). Never commit.
private/

# Wrangler local cache (created when wrangler runs in this folder).
.wrangler/

# Build output (build-app.mjs). Deployed, never committed.
dist/
