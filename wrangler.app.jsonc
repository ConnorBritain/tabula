// The hosted app at debate.tabulaspeech.com: static files only, no server code.
// Deploy (owner's yes first): npx wrangler deploy -c wrangler.app.jsonc
// The build command below runs the gates first; a red test stops the deploy.
// This is a Workers assets project on a route, not a Pages project with a custom
// domain: a route needs no DNS change.
//
// The route debate.tabulaspeech.com/* sends pages here. The tabula-cloud Worker's
// route debate.tabulaspeech.com/api/v1/* is more specific, so the API stays there.
// The proxied placeholder DNS record for debate.tabulaspeech.com stays as it is.
//
// Staging (tabula-cloud docs/DEPLOY.md "Staging site"): debate.tabulaspeech.dev, behind Cloudflare Access.
// Deploy: npx wrangler deploy -c wrangler.app.jsonc --env staging
// It is a custom domain, so the deploy makes its DNS record and certificate. tabula-cloud-staging's route
// debate.tabulaspeech.dev/api/v1/* still wins for the API (a route beats a custom domain, as on tabulaspeech.com).
{
  "name": "tabula-app",
  "account_id": "36bbd78435b2291e928a50731e703509",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node --test && node check-publish.mjs && node build-app.mjs"
  },
  "assets": {
    "directory": "./dist/app"
  },
  "routes": [
    { "pattern": "debate.tabulaspeech.com/*", "zone_name": "tabulaspeech.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "tabula-app-staging",
      "routes": [{ "pattern": "debate.tabulaspeech.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
